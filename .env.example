# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=apollo
PG_USER=apollo
PG_PASSWORD=apollo

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=apollo/telemetry
MQTT_QOS=1

# Modbus TCP
MODBUS_HOST=localhost
MODBUS_PORT=5020
MODBUS_UNIT_ID=1
MODBUS_POLL_SECONDS=2

# Simulation
DATASET_PATH=data/household_power_consumption.txt
DATASET_PROFILE=household
SAMPLE_INTERVAL_SECONDS=0.5
BATCH_SIZE=50
BATCH_SECONDS=2
